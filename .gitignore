# golangci-lint binary (if downloaded locally)
golangci-lint
golangci-lint.exe
test

# lint cache
.golangci-lint-cache/

# local lint-config override (may contain machine-local absolute paths)
.env

# Redis runtime dump
dump.rdb

# generated lint reports
linter-report/
gl-code-quality-report.json
before-fixed/
after-fixed/

# backup files from cmd/lint-fixed-plan-result.sh's pre-fix snapshot step
# (Rule 5a: `cp <file> <file>.bak.<date>`) -- never meant to be committed
*.bak.*
