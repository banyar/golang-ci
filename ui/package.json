    "react-router-dom": "^6.30.0",
    "@tanstack/react-query": "^5.62.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "openapi-typescript": "^7.6.1",
    "swagger2openapi": "^7.0.8"
  }
}
